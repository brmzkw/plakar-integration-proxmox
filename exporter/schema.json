{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plakar Proxmox Exporter Connector Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "mode"
  ],
  "not": {
    "required": [
      "conn_identity_file",
      "conn_identity_key"
    ]
  },
  "properties": {
    "location": {
      "type": "string",
      "minLength": 1,
      "description": "Proxmox endpoint address"
    },
    "mode": {
      "type": "string",
      "description": "Execution mode for proxmox operations",
      "enum": [
        "local",
        "remote"
      ]
    },
    "conn_method": {
      "type": "string",
      "description": "SSH connection method when mode=remote",
      "enum": [
        "password",
        "identity"
      ]
    },
    "conn_username": {
      "type": "string",
      "description": "Proxmox SSH username used in remote mode",
      "minLength": 1
    },
    "conn_password": {
      "type": "string",
      "description": "Password for conn_method=password",
      "minLength": 1
    },
    "conn_identity_file": {
      "type": "string",
      "description": "Path to private key when conn_method=identity",
      "minLength": 1
    },
    "conn_identity_key": {
      "type": "string",
      "description": "Private key content when conn_method=identity, exclusive with conn_identity_file",
      "minLength": 1
    },
    "backup_mode": {
      "type": "string",
      "description": "VZDump backup behavior",
      "enum": [
        "snapshot",
        "suspend",
        "stop"
      ],
      "default": "snapshot"
    },
    "fleecing_storage": {
      "type": "string",
      "description": "Storage for the fleecing images of QEMU backups, overrides /etc/vzdump.conf",
      "minLength": 1
    },
    "dump_dir": {
      "type": "string",
      "description": "Directory used to create/read vzdump archives",
      "default": "/var/lib/vz/dump"
    },
    "node": {
      "type": "string",
      "description": "Optional Proxmox node name"
    },
    "ssh_retry_count": {
      "type": "integer",
      "description": "Number of retries for a failed SSH action (channel/session open) when mode=remote",
      "minimum": 0,
      "default": 3
    },
    "ssh_retry_delay": {
      "type": "string",
      "description": "Delay between SSH retries when mode=remote, as a Go duration (e.g. \"2s\")",
      "default": "2s"
    },
    "start_on_restore": {
      "type": "boolean",
      "description": "Start VM/CT after successful restore",
      "default": false
    },
    "force_vm_restore": {
      "type": "boolean",
      "description": "Allow the restore to overwrite an existing VM/CT, stopping it first if it is running. Without it, a restore onto an existing VMID is refused.",
      "default": false
    },
    "unique": {
      "type": "boolean",
      "description": "Give the restored VM/CT a new identity (random MAC addresses, and a new SMBIOS UUID for QEMU). Defaults to true when newid is set, false otherwise."
    },
    "storage": {
      "type": "string",
      "description": "Storage target for restore"
    },
    "pool": {
      "type": "string",
      "description": "Pool target for restore"
    },
    "newid": {
      "type": "integer",
      "description": "Restore target VMID",
      "minimum": 1
    }
  }
}
